<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CalendarFeed</RootNamespace>
  </PropertyGroup>

  <!-- Runs the same app inside AWS Lambda. Outside Lambda (on your PC) it does nothing. -->
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="1.*" />
  </ItemGroup>

  <!-- Lets the test project see internal classes -->
  <ItemGroup>
    <InternalsVisibleTo Include="CalendarFeed.Tests" />
  </ItemGroup>

</Project>
