# Copy this file to .env (in this same services/python folder) and fill it in.
# .env is ignored by git. Never put the secret key in the app or on GitHub.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys > secret key (or the legacy service_role key)
SUPABASE_SERVICE_ROLE_KEY=
